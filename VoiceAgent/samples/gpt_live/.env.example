# Existing Foundry project with the Voice Agents / GPT Live preview enabled.
FOUNDRY_PROJECT_ENDPOINT=https://YOUR-RESOURCE.services.ai.azure.com/api/projects/YOUR-PROJECT

# Optional existing agent for response_delegation.py.
# The managed-prompt sample always creates two new agents and ignores AGENT_NAME.
AGENT_NAME=

# Both required for the managed-prompt sample, or when AGENT_NAME is blank in the
# original sample. Existing agents use their saved settings.
GPT_LIVE_DEPLOYMENT=YOUR-GPT-LIVE-DEPLOYMENT

# Text deployment: direct Responses backend in the original sample, or the model
# of the prompt agent created by the managed-prompt sample.
RESPONSE_DELEGATION_DEPLOYMENT=YOUR-DELEGATION-DEPLOYMENT
